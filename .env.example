# RecoverIQ Environment Configuration Example
APP_NAME="RecoverIQ — AI Revenue Recovery Agent"
VERSION=1.0.0
ENVIRONMENT=hackathon

# Financial Safeguards & Sandbox
SIMULATION_MODE=true
DEFAULT_CURRENCY=USD
MAX_RETRIES=3
DEFAULT_COOLDOWN_HOURS=24
REQUIRE_APPROVAL_OVER_AMOUNT_CENTS=50000

# Local Ollama AI Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_REQUEST_TIMEOUT=12.0
OLLAMA_MAX_CONTEXT_TOKENS=2048

# Database
DATABASE_URL=sqlite:///./recoveriq.db
